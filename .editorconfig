# EditorConfig helps developers define and maintain consistent coding styles between different editors and IDEs
# For more information about the EditorConfig project, visit http://editorconfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Charset
charset = utf-8

# 2 space indentation for HTML, JavaScript, and CSS files
[*.{js,jsx,ts,tsx,html,css,scss}]
indent_style = space
indent_size = 4

# Tab indentation for YAML files
[*.yml]
indent_style = tab

# Ignore minified JavaScript and CSS files
[**.min.js]
[**.min.css]

# Ignore node_modules directory
[**/node_modules/**]
